# Sports Data MCP - Environment Configuration
# =============================================

# The Odds API Configuration (REQUIRED for betting odds)
# Get your API key from: https://the-odds-api.com
#
# Multiple keys may be supplied comma separated. They are used one at a time:
# the first key is drained, and only when it is out of credits (or rejected)
# does the server move to the next. Draining one key at a time keeps the
# others at full quota as reserve and keeps the reported "requests remaining"
# figure meaningful. A key rejected as invalid is retired for the session.
# Example: ODDS_API_KEY=key_one,key_two
ODDS_API_KEY=your_odds_api_key_here

# ---------------------------------------------------------------------------
# Live Tennis API (OPTIONAL) - live tennis scores, fixtures, players
# ---------------------------------------------------------------------------
# Set TENNIS_API_KEY to enable the tennis tools (ATP/WTA/Challenger/ITF live
# scores, fixtures, and player lookups). Leave it unset and the server still
# runs — the tennis tools simply are not registered.
#
# Get a free key (no card) at: https://livetennisapi.com/subscribe/free
#
# TIER CONTRACT: free tier for fixtures, player lookups and low-cadence score
# checks; paid tier for live match-following. The free key is 30 requests/min
# and 100 requests/DAY. Live scores are included, but the daily cap is the
# real limit:
#
#   * At the default 30s live TTL (CACHE_TTL_TENNIS_LIVE below), following one
#     three-hour match refreshes ~360 times — it exhausts a free key's whole
#     day inside a single match.
#   * A free key sustains ~one score check every 15 minutes (~96/day), plus
#     fixtures and player lookups, plus develop-and-test.
#   * For real live match-following use Basic ($9.99/mo, 60/min - 1k/day) or,
#     for a full Slam board, Pro (300/min - 10k/day).
#
# CACHE_TTL_TENNIS_LIVE is the free-tier survival knob. Raising it trades
# freshness for quota: a 900s TTL keeps a whole day of casual score-checking
# inside the free 100/day allowance.
# TENNIS_API_KEY=your_live_tennis_api_key_here
# CACHE_TTL_TENNIS_LIVE=30       # live match list + single-match score (seconds)
# CACHE_TTL_TENNIS_FIXTURES=300  # upcoming fixtures
# CACHE_TTL_TENNIS_PLAYER=3600   # player profile / ranking / Elo
# CACHE_TTL_TENNIS_USAGE=15      # /usage recovery read — keep short, kept
#                                # independent of LIVE so a daily-quota re-check
#                                # is never answered from a raised live cache

# Optional: Filter Bookmakers/Sportsbooks
# Comma-separated list of bookmaker keys to include in odds results
# Leave empty or comment out to include all bookmakers
# Common bookmakers: draftkings, fanduel, betmgm, caesars, barstool, 
#   pointsbet, bet365, mybookieag, bovada, williamhill
# Example: BOOKMAKERS_FILTER=draftkings,fanduel,betmgm
# BOOKMAKERS_FILTER=

# Optional: Maximum number of bookmakers to show per game
# Default: 5 (if not set or empty)
# BOOKMAKERS_LIMIT=5

# ---------------------------------------------------------------------------
# BetTrack Dashboard Integration (OPTIONAL)
# ---------------------------------------------------------------------------
# Set DASHBOARD_API_KEY to enable the dashboard tools: bet tracking, betting
# stats, and the analytics suite (arbitrage, closing line value, sharp money,
# line movement, market disagreement, bookmaker metrics).
#
# Leave it unset and the server still runs — you simply get the sports data
# tools only, and no dashboard tools appear in Claude.
#
# Generate a key in the dashboard under Settings -> API Keys. Grant it the
# 'stats' permission for analytics tools and 'bets' for bet tools.
# DASHBOARD_API_KEY=sk_your_api_key_here

# Dashboard base URL. Defaults to http://localhost:3001 when unset.
#
# SECURITY: this MUST be https:// for any hosted or remote deployment. Plain
# http:// sends your API key and bet history unencrypted. It is acceptable
# ONLY for localhost on your own machine. The server logs a warning if you
# point a plain http:// URL at a non-loopback host.
# DASHBOARD_API_URL=https://your-dashboard.example.com

# ---------------------------------------------------------------------------
# Response Cache (OPTIONAL)
# ---------------------------------------------------------------------------
# Repeated questions in one conversation are served from memory instead of
# spending an Odds API request. The free tier allows 500 requests a month, so
# this matters. Cached entries are short lived and concurrent identical
# requests are coalesced into one upstream call.
#
# Set to false to disable entirely (every call then hits the API).
# CACHE_ENABLED=true

# Maximum cached responses held in memory. Oldest are evicted first.
# CACHE_MAX_ENTRIES=256

# Cache lifetimes in seconds. Lower means fresher data and more API usage.
# CACHE_TTL_ODDS=60          # betting odds and event odds
# CACHE_TTL_SCORES=60        # live and recent scores
# CACHE_TTL_SCOREBOARD=30    # ESPN scoreboards (no API key, so no quota cost)
# CACHE_TTL_SPORTS=3600      # the list of available sports

# Optional: Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
